# Environment Configuration

# Server
NODE_ENV=development
PORT=3000
DOMAIN=http://localhost:3000

# Stripe Configuration
STRIPE_PUBLIC_KEY=pk_test_your_public_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Database (optional - يمكن استخدام MongoDB أو أي قاعدة بيانات أخرى)
# DATABASE_URL=mongodb://localhost:27017/youtube-to-mp3

# Email Configuration (optional - لإرسال رسائل تأكيد)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# YouTube API (optional - للحصول على معلومات الفيديو)
# YOUTUBE_API_KEY=your_youtube_api_key_here

# Logging
LOG_LEVEL=info
